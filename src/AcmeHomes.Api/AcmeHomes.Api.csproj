<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Image name for `dotnet publish -t:PublishContainer`. The SDK builds the image itself, so there's no Dockerfile. -->
    <ContainerRepository>acmehomes-api</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcmeHomes.Infrastructure\AcmeHomes.Infrastructure.csproj" />
    <ProjectReference Include="..\AcmeHomes.ServiceDefaults\AcmeHomes.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets integration tests deserialize into the same internal response records the API returns. -->
    <InternalsVisibleTo Include="AcmeHomes.Api.IntegrationTests" />
  </ItemGroup>

</Project>
