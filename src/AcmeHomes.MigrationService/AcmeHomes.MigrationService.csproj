<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Image name for `dotnet publish -t:PublishContainer`. The SDK builds the image itself, so there's no Dockerfile. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>acmehomes-migrations</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcmeHomes.Infrastructure\AcmeHomes.Infrastructure.csproj" />
    <ProjectReference Include="..\AcmeHomes.ServiceDefaults\AcmeHomes.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
